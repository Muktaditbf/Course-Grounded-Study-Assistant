<?xml version="1.0" encoding="utf-8"?>
<!--
  The card -> detail morph: the tapped card's title travels to the detail header,
  changing position, size and text colour on the way. Kept to 260ms so the app still
  feels immediate when demonstrated on a projector.
-->
<transitionSet xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:transitionOrdering="together">
    <changeBounds />
    <changeTransform />
    <changeClipBounds />
    <changeImageTransform />
</transitionSet>
