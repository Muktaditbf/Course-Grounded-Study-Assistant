<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Who is signed in -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_on_primary_soft"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_glass"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_micro"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Account -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/account"
                style="@style/TextLabel" />

            <LinearLayout
                android:id="@+id/groupAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <!-- Preferences -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/preferences"
                style="@style/TextLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <RadioButton android:id="@+id/rbLight" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/theme_light"
                        android:textSize="@dimen/text_caption" />
                    <RadioButton android:id="@+id/rbDark" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/theme_dark"
                        android:textSize="@dimen/text_caption" />
                    <RadioButton android:id="@+id/rbSystem" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/theme_system"
                        android:textSize="@dimen/text_caption" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notifications_toggle"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/notifications_summary"
                            style="@style/TextCaption" />
                    </LinearLayout>

                    <!-- SwitchMaterial, not MaterialSwitch: the latter needs a Material3 theme and renders
                         invisible under this app's Material2 theme. Its on/off labels are set
                         empty because SwitchCompat measures them even when unused and NPEs on
                         null; the visible label sits beside the switch. -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:showText="false"
                        android:textOff=""
                        android:textOn=""
                        android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Language, mirroring the Theme card above so the two preferences match -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language"
                    style="@style/TextHeading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/language_choose"
                    style="@style/TextCaption" />

                <RadioGroup
                    android:id="@+id/rgLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbLangSystem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language_system"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />

                    <RadioButton
                        android:id="@+id/rbLangEnglish"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language_english"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />

                    <RadioButton
                        android:id="@+id/rbLangBangla"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language_bangla"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />
                </RadioGroup>
            </LinearLayout>

            <!-- Support -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/support"
                style="@style/TextLabel" />

            <LinearLayout
                android:id="@+id/groupSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <!-- Session -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/session"
                style="@style/TextLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/logout"
                android:textColor="@color/danger"
                app:strokeColor="@color/danger"
                style="@style/SecondaryButton" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:background="@color/surface"
        android:visibility="gone"
        app:menu="@menu/nav_student"
        app:itemIconTint="@color/nav_tint"
        app:itemTextColor="@color/nav_tint"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp" />
</LinearLayout>
