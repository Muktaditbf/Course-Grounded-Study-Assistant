<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Gradient hero: greeting, plan chip, and the primary Ask action -->
    <LinearLayout
        android:id="@+id/heroStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hero_card"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:elevation="6dp"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting"
                    android:textColor="@color/text_on_primary_soft"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:maxLines="1"
                android:minHeight="32dp"
                android:gravity="center"
                android:background="@drawable/bg_glass"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Notifications. Logout moved to Settings, where it can confirm first. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm">

                <ImageView
                    android:id="@+id/btnBell"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_glass"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="@string/notifications"
                    app:tint="@color/white"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvBellCount"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:minWidth="18dp"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:background="@drawable/bg_badge"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/your_courses"
                    style="@style/TextTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJoin"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/join_course"
                    app:icon="@drawable/ic_add"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    style="@style/SmallButton" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:text="@string/no_courses_student"
                style="@style/TextCaption"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
