<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="56dp"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/msgText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_ai"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body" />

    <!-- Which approved material the answer came from; hidden when it was general knowledge -->
    <TextView
        android:id="@+id/msgSources"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginStart="6dp"
        android:textSize="@dimen/text_micro"
        android:textColor="@color/locked_green_text"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
